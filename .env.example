# Both keys are optional; set at least one. OpenRouter is tried first, then Gemini.
# OpenRouter: https://openrouter.ai/keys   Gemini: https://aistudio.google.com/apikey
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free
# OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free,recursive/flint-v1.0:free,poolside/laguna-s-2.1:free
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free

# Deploying (anywhere other than this laptop): set a long, random password so only you can open the app and spend
# your AI keys. Each device asks for it once. Changing it signs every device out. On Vercel the AI and Drive
# features stay off until it's set.
# APP_PASSWORD=
# Without a password the API answers only to localhost/127.0.0.1 (this blocks DNS-rebinding attacks on a laptop
# copy) and the names listed here, comma-separated. This is NOT a lock: anyone who can reach the server can send any
# host name, so only use it on a network you trust. A copy on the internet needs APP_PASSWORD.
# ALLOWED_HOSTS=my-laptop.local

# ---------- Accounts (optional; Phase 2b) ----------
# Without these the app runs exactly as before: data on this device only, no account options shown.
# Accounts switch on only when every required value is set, the project's ref is listed for this environment in
# src/lib/supabase/projects.ts (both lists start empty, so accounts start off everywhere), AND SUPABASE_ENV matches:
#   this computer and Vercel Preview → development (the DEVELOPMENT Supabase project)
#   Vercel Production                → production  (the PRODUCTION project; set up separately, with approval)
# Never put production values in .env.local or the Preview environment.
#
# Server-only (never NEXT_PUBLIC_): the browser never talks to Supabase; all sign-in goes through this app's server.
# SUPABASE_URL=https://<dev-project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=            # the project's publishable (anon) key, NOT the secret/service-role key
# SUPABASE_ENV=development
#
# Public by design (it is shown in the page): Cloudflare Turnstile site key for the sign-in forms.
# Its secret key goes into Supabase (Authentication → Bot protection), not here.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
#
# Rate limits for the sign-in endpoints. On Vercel all three are REQUIRED (accounts stay off without them).
# On this computer they may be left out: an in-memory limiter is used, which refuses to run on Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_SECRET=                   # 32+ random characters; keys limits by email without storing addresses
