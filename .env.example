# All keys are optional; set at least one. OpenRouter is tried first, then Gemini, then Groq (Groq can't read scans).
# Gemini: https://aistudio.google.com/apikey   Groq: https://console.groq.com/keys   OpenRouter: https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free
# OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free,recursive/flint-v1.0:free,poolside/laguna-s-2.1:free
# OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,google/gemma-4-31b-it:free

# Deploying (anywhere other than this laptop): set a password so only you can open the app and spend your AI keys.
# Each device asks for it once. Changing it signs every device out.
# APP_PASSWORD=
# The API answers only to IP addresses and localhost unless a password is set (this blocks DNS-rebinding attacks
# on a laptop copy). To serve it under a domain without a password, list the names here, comma-separated.
# ALLOWED_HOSTS=exams.example.com
